# Public Mapbox token (starts with pk.). Create one at https://account.mapbox.com/access-tokens/
# and restrict it to your site's URLs. Never put a secret token (sk.) here: this value is sent to the browser.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional Rotation Explorer provider overrides. Without these, Mapbox search and the app's
# NASA POWER weather loader are used when configured and available.
FIELDSHIFT_LOCATION_SEARCH_URL=
FIELDSHIFT_ENVIRONMENT_URL=

# Study Area Boundaries GeoJSON (server only). Absolute path to rights-cleared GeoJSON file
# containing the 162 Myanmar townships. If unset, boundary overlays are disabled and farmers
# define fields manually via satellite box/draw.
FIELDSHIFT_TOWNSHIPS_PATH=

# NASA Earthdata login (server only). Without these, the sources below report "not connected" and the app
# falls back to NASA POWER or shows the value as unknown. Nothing is estimated in their place.
#
# AppEEARS: SMAP soil moisture, HLS vegetation, SRTM terrain (and optional MODIS and ECOSTRESS).
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
# An Earthdata user token, for GPM IMERG daily rainfall from GES DISC (https://urs.earthdata.nasa.gov/).
EARTHDATA_TOKEN=

# Optional: shared server cache so results survive restarts. Without it an in-memory cache is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
