{
  "name": "green-aaly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/ensure-datasets.mjs && next build",
    "build:webpack": "next build --webpack",
    "verify:datasets": "node scripts/ensure-datasets.mjs",
    "predownload": "bun scripts/predownload-heartland.ts",
    "test:e2e": "playwright test",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:quiet": "vitest run --reporter=dot",
    "test:changed": "vitest run --changed",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:rotation": "node test/rotation-integration.test.mjs",
    "validate:weather": "vitest run --config vitest.validation.config.mts"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
